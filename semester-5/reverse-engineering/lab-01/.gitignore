# Сборка и рабочие файлы инструментов анализа
/build/
/cmake-build-*/
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til
*.dd64
*.dd32
*.bak

# Результаты запусков генерируются заново
report.txt
serial.txt

# Отчёты и снимки экрана хранятся отдельно от исходников
*.docx
*.pdf
/скрины/
/.codex_work/
/архив/

# Исключения из общего правила репозитория *.exe:
# это сохранённые образцы для реверс-инжиниринга, а не каталог сборки.
!/binaries/*.exe
!/пункт12/crackme_protected_patched.exe
!/пункты13-15/crackme_protected_packed.exe
