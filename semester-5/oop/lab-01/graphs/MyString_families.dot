digraph MyString {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=16, nodesep=0.28, ranksep=0.85, pad=0.25, splines=true, labelloc=t, label="MyString: граф вызовов методов\nСтрелка: вызывающий метод → вызываемый метод"];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#333333", fontname="Arial", fontsize=11, margin="0.13,0.10"];
  edge [color="#777777", arrowsize=0.65, penwidth=0.8];
