  n23 [label="MyString::operator>="];
  n24 [label="MyString::operator[]\n(2 перегрузки)"];
  n25 [label="MyString::replace\n(9 перегрузок)"];
  n26 [label="MyString::shrink_to_fit"];
  n27 [label="MyString::size"];
  n28 [label="MyString::substr\n(2 перегрузки)"];
  n29 [label="MyString::swap", fillcolor="#eeeeee"];
  n30 [label="MyString::~MyString"];
  n0 -> n2;
